{
  "name": "openclaw-zenmux-multiprotocol-provider",
  "version": "0.7.0",
  "description": "ZenMux LLM provider plugin for OpenClaw \u2014 multi-protocol with native OpenAI, Anthropic, and Vertex transports",
  "license": "MIT",
  "author": "abnershang (fork of zenmux/openclaw-zenmux-provider v0.2.0)",
  "type": "module",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "llm",
    "zenmux",
    "ai",
    "provider"
  ],
  "files": [
    "dist/",
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "FORK-NOTES.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "zenmux",
      "zenmux-openai",
      "zenmux-anthropic",
      "zenmux-vertex"
    ],
    "compat": {
      "pluginApi": ">=2026.4.14",
      "minGatewayVersion": "2026.4.14"
    },
    "build": {
      "openclawVersion": "2026.4.14",
      "pluginSdkVersion": "2026.4.14"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.14"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "openclaw": ">=2026.4.14",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
